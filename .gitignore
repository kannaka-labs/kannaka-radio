# Dependencies
node_modules/
package-lock.json

# Kannaka data
.kannaka/

# PID file
.radio.pid

# Live recording chunks
chunks/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Runtime
.env
.env.local

# Audio files — too large for git; run setup.ps1 to populate music/ locally
*.mp3
*.wav
*.flac
*.m4a
*.ogg

# Runtime / generated assets
workspace/models/art/
music/Ghost Signals Podcast/

# Podcast workspace: track scripts, upload/build tooling, metadata, and
# covers — but not rendered media (mp3/mp4 live on Oracle radio + YouTube)
# or the downloaded KAX art cache.
workspace/podcasts/**/*.mp3
workspace/podcasts/**/*.mp4
workspace/podcasts/art/
workspace/podcasts/audio/
workspace/podcasts/renders/*
!workspace/podcasts/renders/*.png
!workspace/podcasts/renders/*.jpg

# Per-feature scheduler state — date-keyed dedup files written by the
# peace-oration / news-broadcast / gossip-broadcast / showcase pipelines.
# These are local runtime state, not source. Same for the recently-played
# panel cache.
workspace/peace-oration-state.json
workspace/news-broadcast-state.json
workspace/gossip-broadcast-state.json
workspace/showcase-state.json
workspace/recently-played.json
# Voice write-back runtime state: the cross-process dedupe ledger (and its
# lock) and the on-air digest's buffer of lines not yet written.
workspace/voice-writeback-ledger.jsonl*
workspace/on-air-digest-buffer.jsonl*
# Publication ledger (server/lib/publication-ledger.js) and the nightly confab
# rates (scripts/confab-rate.js): runtime evidence, never source.
workspace/publication-ledger.jsonl*
workspace/confab-rates.json
workspace/confab-rates.md
# Guest consent and withdrawal (server/guest-consent.js, guest-withdrawal.js):
# guests' contact addresses, who withdrew and when. Personal data, never source.
workspace/guest-consent.json*
workspace/guest-airings.json*
workspace/guest-withdrawals.jsonl*
workspace/guest-withdraw-outbox.jsonl*
# Durable play history (Deep Cuts). Same reason: runtime state, and it is
# per-station — a committed copy would tell another box that tracks it has
# never aired were already played.
workspace/play-history.json
workspace/news-teaser-state.json
workspace/news-teaser-fingerprint.json
workspace/override-state.json

# Live counters written by the running service (listener uniques, etc.)
data/listener-totals.json

# Oracle-side runtime scripts — the production box has its own copies of
# cron wrappers (prune-cron, run-push-nats) that source local env files.
prune-cron.sh
run-push-nats.sh

# Broadcaster credentials
.bluesky.json
.mastodon.json
.telegram.json
.nostr.json
.youtube.json
.youtube-client.json
workspace/rare-singles.json

# Python bytecode from workspace scripts
__pycache__/

# Podcast + drama renders. Scripts, art manifests and episodes.json are the
# record and ARE tracked; the audio is not — episodes 031-034 alone are 116MB
# and workspace/tsof is 554MB. Losing a render costs a re-render from the
# script that is in here; losing the script costs the episode.
workspace/podcasts/*/*.mp3
workspace/podcasts/*/*.wav
workspace/podcasts/renders/
# TSOF: the RENDERS only. The scripts, slide lists, voice maps and score
# plans under workspace/tsof are the record of the season and are tracked —
# 40 files, 284K, against 588 mp3s. An earlier version of this rule ignored
# workspace/tsof wholesale and would have dropped all eight episodes' scripts,
# which is the opposite of the rule stated above it.
workspace/tsof/**/*.mp3
workspace/tsof/**/*.wav
workspace/tsof/**/*.png
# Slideshow art is regenerated from art/manifest.json + images.txt, which ARE
# tracked. Master tracks no episode art either; this matches it.
workspace/podcasts/*/art/*.png
